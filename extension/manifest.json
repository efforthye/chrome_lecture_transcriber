{
  "manifest_version": 3,
  "default_locale": "ko",
  "name": "Lecture Transcriber",
  "description": "__MSG_extDescription__",
  "version": "0.9.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "scripting",
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_commandDesc__"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Lecture Transcriber",
  "description": "강의 영상을 클릭하면 오디오를 받아 Whisper로 타임스탬프 스크립트(.txt)를 만들고, 유튜브는 자막을 바로 가져옵니다.",
  "version": "0.7.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "scripting",
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lecture Transcriber",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "현재 탭에서 영상 선택해서 스크립트 만들기"
    }
  }
}
